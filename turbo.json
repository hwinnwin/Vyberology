{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ]
    },
    "mobile#build": {
      "dependsOn": [
        "@vybe/analytics-adapter#build",
        "@vybe/reading-engine#build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
